generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum CompanyStatus {
  ACTIVE
  PASSIVE
  ARCHIVED
}

enum PlanPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  LINKEDIN
  TIKTOK
  X
  YOUTUBE
}

enum AccountStatus {
  ACTIVE
  PASSIVE
}

enum ContentType {
  POST
  STORY
  REEL
  VIDEO
}

enum ContentStatus {
  DRAFT
  PREPARING
  TEAM_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
}

enum TaskStatus {
  WAITING
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum NoteType {
  GENERAL
  QUICK
  MEETING
  PINNED
}

enum NoteCategory {
  GENERAL
  DESIGN
  CONTENT
  ADS
  MEETING
  REMINDER
  OTHER
}

enum NotificationType {
  DAILY_TASK_SUMMARY
  TASK_ASSIGNED
  TASK_UPDATED
  DUE_IN_3_DAYS
  DUE_IN_1_DAY
  DUE_TODAY
  TASK_OVERDUE
  CONTENT_APPROVED
  CONTENT_REVISION
  CONTENT_SCHEDULED_TODAY
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(EMPLOYEE)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedCompanies Company[]         @relation("CompanyAssignee")
  authoredContents  Content[]         @relation("ContentAuthor")
  contentRevisions  ContentRevision[]
  createdTasks      Task[]            @relation("TaskCreator")
  assignedTasks     Task[]            @relation("TaskAssignee")
  taskComments      TaskComment[]
  meetingsCreated   Meeting[]         @relation("MeetingCreator")
  meetingParts      MeetingParticipant[]
  notifications     Notification[]
  activities        ActivityLog[]
  notesCreated      AgencyNote[]      @relation("NoteCreator")
  notesUpdated      AgencyNote[]      @relation("NoteUpdater")
}

model Company {
  id           String        @id @default(cuid())
  name         String
  logo         String?
  sector       String?
  phone        String?
  email        String?
  website      String?
  address      String?       @db.Text
  brandColors  String?
  brandVoice   String?       @db.Text
  brandNotes   String?       @db.Text
  status       CompanyStatus @default(ACTIVE)
  assigneeId   String?
  assignee     User?         @relation("CompanyAssignee", fields: [assigneeId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  socialAccounts SocialAccount[]
  contents       Content[]
  tasks          Task[]
  notes          AgencyNote[]
}

model SocialAccount {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform    SocialPlatform
  username    String
  profileUrl  String?
  description String?        @db.Text
  status      AccountStatus  @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([companyId])
}

model Content {
  id          String        @id @default(cuid())
  title       String
  body        String        @db.Text
  platform    SocialPlatform
  type        ContentType   @default(POST)
  mediaPath   String?
  hashtags    String?       @db.Text
  publishAt   DateTime?
  status        ContentStatus @default(DRAFT)
  notes         String?       @db.Text
  autoGenerated Boolean       @default(false)
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  authorId      String
  author        User          @relation("ContentAuthor", fields: [authorId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  revisions ContentRevision[]

  @@index([companyId])
  @@index([authorId])
  @@index([publishAt])
  @@index([status])
  @@index([autoGenerated])
}

model ContentRevision {
  id            String   @id @default(cuid())
  contentId     String
  content       Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  comment       String   @db.Text
  action        String
  requestedById String
  requestedBy   User     @relation(fields: [requestedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([contentId])
}

model Task {
  id             String         @id @default(cuid())
  title          String
  description    String?        @db.Text
  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       User?          @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId      String
  creator        User           @relation("TaskCreator", fields: [creatorId], references: [id])
  priority       TaskPriority   @default(NORMAL)
  status         TaskStatus     @default(WAITING)
  startDate      DateTime?
  dueDate        DateTime?
  planPeriod     PlanPeriod     @default(WEEKLY)
  planPosts      Int            @default(0)
  planStories    Int            @default(0)
  planReels      Int            @default(0)
  planVideos     Int            @default(0)
  /// Tip başına yayın saatleri: { "POST": ["09:00","18:00"], "STORY": ["12:00"] }
  planTimes      Json?
  recurrence     TaskRecurrence @default(NONE)
  recurrenceOfId String?
  recurrenceOf   Task?          @relation("TaskOccurrences", fields: [recurrenceOfId], references: [id], onDelete: Cascade)
  occurrences    Task[]         @relation("TaskOccurrences")
  occurrenceDate DateTime?
  /// Şablonda: silinen günler (YYYY-MM-DD) — sync bu günleri yeniden üretmez
  skippedOccurrenceDates Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  comments TaskComment[]

  @@index([assigneeId])
  @@index([companyId])
  @@index([dueDate])
  @@index([status])
  @@index([recurrence])
  @@index([recurrenceOfId])
  @@index([occurrenceDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  date        DateTime @db.Date
  time        String
  notes       String?  @db.Text
  decisions   String?  @db.Text
  creatorId   String
  creator     User     @relation("MeetingCreator", fields: [creatorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants MeetingParticipant[]
}

model MeetingParticipant {
  id        String  @id @default(cuid())
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String           @db.Text
  readAt     DateTime?
  entityType String?
  entityId   String?
  createdAt  DateTime         @default(now())

  @@index([userId, readAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  meta       String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model AgencyNote {
  id          String       @id @default(cuid())
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  type        NoteType     @default(GENERAL)
  category    NoteCategory @default(GENERAL)
  tags        String?
  body        String       @db.Text
  createdById String
  createdBy   User         @relation("NoteCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?        @relation("NoteUpdater", fields: [updatedById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId])
  @@index([type])
}
